<UserControl x:Class="Switchboard.Views.GetModsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The Get mods tab: fetch a release from GitHub, or install a dll from a URL.

        Separate from the Mods tab on purpose. That one is bookkeeping over files already on disk and
        never touches the network; this one downloads code that will be executed by the game. Keeping them
        apart means the Mods tab's promise - it moves and deletes files, nothing more - stays true, and
        the consequences of installing are somewhere you only arrive deliberately.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What this tab is for, in one line, under the tab strip. -->
        <TextBlock x:Name="PurposeText" Grid.Row="0" Classes="purpose" Margin="0,0,0,10" />

        <!--
            Bounded on purpose. The report below it names what could not be read and which entries are
            out of step, and an unbounded wrapping line would grow until the table it is describing had
            no height left - which is how a long failure list turns the list into an empty box. Three
            lines and an ellipsis; the status bar at the bottom of the window has the whole sentence.
        -->
        <TextBlock x:Name="Summary" Grid.Row="1" Classes="status" MaxLines="3"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="124" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mod" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="Release" Classes="columnHeader"
                           ToolTip.Tip="The release Install takes: the one the list reviewed." />
                <TextBlock Grid.Column="2" Text="Newest" Classes="columnHeader"
                           ToolTip.Tip="The author's latest release on GitHub. Coloured when it is not the one above." />
                <TextBlock Grid.Column="3" Text="Reviewed" Classes="columnHeader"
                           ToolTip.Tip="Whether the list recorded hashes for what it installs: yes, partly, or no." />
                <TextBlock Grid.Column="4" Text="Size" Classes="columnHeader"
                           ToolTip.Tip="Download size of the release." />
                <TextBlock Grid.Column="5" Text="Installed" Classes="columnHeader"
                           ToolTip.Tip="What is in the game folder now, read from the file itself." />
                <TextBlock Grid.Column="6" Text="What it does" Classes="columnHeader" />
            </Grid>

            <Border Grid.Row="0" Classes="rule" VerticalAlignment="Bottom" />

            <ListBox x:Name="List" Grid.Row="1" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="tableRow">
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell" />
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" Classes="cell" />
                                <TextBlock Grid.Column="2" Text="{Binding Latest}" Classes="cell"
                                           Foreground="{Binding LatestBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reviewed}" Classes="cell" />
                                <TextBlock Grid.Column="4" Text="{Binding Size}" Classes="cell" />
                                <TextBlock Grid.Column="5" Text="{Binding Installed}" Classes="cell"
                                           Foreground="{Binding InstalledBrush}" />
                                <TextBlock Grid.Column="6" Text="{Binding What}" Classes="cell" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                The same empty state as the other tabs, and for the same reason: a table with a
                header row and nothing under it cannot be told apart from a tab that is broken.
            -->
            <Border x:Name="Empty" Grid.Row="1" Classes="empty" IsVisible="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Classes="emptyTitle" />
                    <!--
                        Bounded for the same reason the summary is: this one carries the reason the list
                        could not be read, which is one sentence per repository when GitHub refuses the
                        requests - and an unbounded hint draws straight over the buttons below it.
                    -->
                    <TextBlock x:Name="EmptyHint" Classes="emptyHint" MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            "Refresh from GitHub" rather than "Check for updates": the status bar has a button with
            almost the same words, and that one is about Switchboard itself rather than about the
            mods in the list. Two buttons called "Check for updates" in one window is one too many.

            One install button. The newest release is offered inside the confirmation, where the
            difference between it and the reviewed one is a sentence rather than a second button
            competing with the first.
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="CheckButton" Content="Refresh from GitHub" MinWidth="150"
                    Theme="{StaticResource FlatButton}" Click="OnCheck" />
            <Button x:Name="InstallButton" Content="Install..." Margin="8,0,0,0" MinWidth="130"
                    Cursor="Hand" Theme="{StaticResource AccentButton}" Click="OnInstall" />
        </StackPanel>

        <!--
            The selected row's three versions in a sentence: what the list lists, what GitHub has, what
            is on disk. The columns show them side by side; this says which of them is out of step and
            what installing the newest release would mean, because a colour and a suffix cannot.
        -->
        <TextBlock x:Name="Detail" Grid.Row="4" Classes="note" Margin="0,0,0,12"
                   MaxLines="3" TextTrimming="CharacterEllipsis" />

        <!-- The textbox takes the room the row has, rather than a fixed width that does not fit a URL. -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Install a dll from a URL"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />

            <TextBox x:Name="UrlBox" Grid.Column="1" VerticalContentAlignment="Center" />

            <Button x:Name="FromUrlButton" Grid.Column="2" Content="Download and install..." Margin="8,0,0,0"
                    Theme="{StaticResource FlatButton}" Click="OnFromUrl" />
        </Grid>

        <TextBlock Grid.Row="6" Classes="note" Foreground="{StaticResource WarnBrush}"
                   Text="Installing runs new code inside your game. Install what you trust." />
    </Grid>
</UserControl>
